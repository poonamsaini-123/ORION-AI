# ORION reads these from the environment (export them, or set them on your host).
HOST=127.0.0.1
PORT=8000

# Where tasks.json lives. Point at a persistent disk when deploying.
ORION_DATA_DIR=

# Public hostname(s) allowed to call /mcp, comma-separated (MCP DNS-rebinding
# protection). Render's hostname is added automatically.
ORION_ALLOWED_HOSTS=

# Optional Amazon Bedrock voice polish (pip install boto3, AWS credentials required)
ORION_BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
